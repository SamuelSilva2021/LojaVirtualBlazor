<div class="modal fade" data-backdrop="static" data-keyboard="false" id="deleteConfirmationModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Confirma deletar</h5>
                <button type="button" @onclick="()=>OnConfirmationDelete(false)" class="btn-close" data-dismiss="modal" aria-label="Fechar">                    
                </button>
            </div>
            <div class="modal-body">
                @Text @Nome?
            </div>
            @if (IsParentComponentProcessing)
            {
                //se estiver no loading...
                <div class="modal-footer">
                        <button type="button" disabled class="rz-button rz-button-md rz-variant-filled rz-primary rz-shade-default" id="rRFLR-aeWU">Cancelar</button>
                        <button type="button" disabled class="rz-button rz-button-md rz-variant-filled rz-secondary rz-shade-default" id="2uEbr9J01U">Processando...</button>
                </div>
            }
            else
            {
                <div class="modal-footer">
                    <button type="button" @onclick="()=>OnConfirmationDelete(false)" class="rz-button rz-button-md rz-variant-filled rz-primary rz-shade-default" id="rRFLR-aeWU">
                       <span class="rz-button-box">
                           <span class="rz-button-text">Cancelar</span>
                       </span>
                    </button>
                    <button type="button" @onclick="()=>OnConfirmationDelete(true)" class="rz-button rz-button-md rz-variant-filled rz-secondary rz-shade-default" id="2uEbr9J01U">
                       <span class="rz-button-box">
                           <span class="rz-button-text">Deletar</span>
                       </span>
                    </button>
                </div>
            }            
        </div>
    </div>
</div>

@code {
    [Parameter]
    public bool IsParentComponentProcessing{ get; set; }
    [Parameter]
    public EventCallback<bool> ConfirmationChanged { get; set;}
    [Parameter]
    public string Nome { get; set; }
    [Parameter]
    public string Text { get; set; }

    private async Task OnConfirmationDelete(bool value)
    {
        if (value)
        {
            ConfirmationChanged.InvokeAsync(value);
        }
    }

}
