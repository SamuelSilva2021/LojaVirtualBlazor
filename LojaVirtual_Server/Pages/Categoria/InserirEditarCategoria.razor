@page "/categoria/create"
@page "/categoria/edit/{id:int}"

@inject ICategoriaRepository _categoriaRepository
@inject NavigationManager _navigationManager

<div class="row my-2">
        @if (IsLoading)
        {
            <div class="d-flex justify-content-center">
                <div class="text-center">
                    <img src="/images/loading.gif">
                </div>
            </div>
        }
        else
        {
            <div class="col-6">
                <RadzenTemplateForm TItem="CategoriaDTO"  Data="@Categoria" Submit="@((CategoriaDTO args) => { OnSubmit(args); })">
                    <DataAnnotationsValidator/>
                    <div class="container-fluid">
                        <div class="row">
                        <div class="col-md-12">
                            <RadzenFieldset Text="Informações da Categoria">
                                <div class="row">
                                <div class="col-md-2 align-items-center d-flex">
                                    <RadzenLabel Text="Nome" />
                                </div>
                                <div class="col-md-10">
                                     <RadzenTextBox style="width: 100%;" Name="Nome" @bind-Value=@Categoria.Nome/>
                                     <ValidationMessage For="() => Categoria.Nome"/>
                                </div>
                            </div>
                            </RadzenFieldset>
                        </div>
                    </div>
                        <div class="col-md-10 d-flex align-items-end justify-content-end" style="margin-top: 16px;">
                                <RadzenButton ButtonType="ButtonType.Submit" Icon=@iconBotao Text=@textoBotao />
                            <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="cancel" style="display: inline-block; margin-left: 10px;" Text="Cancel" Click="@Cancel" />
                        </div>
                    </div>
                </RadzenTemplateForm>
            </div>           
        }
</div>


@code {
    [Parameter]
    public int Id { get; set; }

    private CategoriaDTO Categoria { get; set; } = new CategoriaDTO();
    private string TitleWindow { get; set; } = "Adicionar Categoria";
    private string iconBotao = "save";
    private string textoBotao = "Salvar";

    private bool IsLoading { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Id == 0)
        {
            //Create
            IsLoading = false;
        }
        else
        {
            textoBotao = "Editar";
            TitleWindow = "Editar Categoria";
            iconBotao = "edit";
            await CarregaCategorias();
        }
    }
    private async Task CarregaCategorias()
    {
        IsLoading = true;
        StateHasChanged();
        Categoria = await _categoriaRepository.Get(Id);
        IsLoading = false;
        StateHasChanged();
    }

    //Inserir categoria
    async void OnSubmit(CategoriaDTO categoria)
    {
        if (Id == 0)
            await _categoriaRepository.Create(categoria);
        else
            await _categoriaRepository.Update(categoria);
        _navigationManager.NavigateTo("categoria");
    }
    void Cancel()
    {
        _navigationManager.NavigateTo("/categoria");
    }
}
