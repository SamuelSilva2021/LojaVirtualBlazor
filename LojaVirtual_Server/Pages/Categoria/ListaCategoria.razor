@page "/categoria"
@inject ICategoriaRepository _categoriaRepository
@inject IJSRuntime _jsRuntime
@inject NavigationManager _navigationManager


<DialogConfirm IsParentComponentProcessing="IsLoading" ConfirmationChanged="ConfirmaDelete" Text="@textModal" Nome="@NomeCategoria"></DialogConfirm>

<div class="row mt-4">
    <div class="col-12 p-3">
        @if (Categorias.Any())
        {
            <RadzenText TextStyle="TextStyle.H3" TagName="TagName.H1" Class="my-1">
                    Categorias
            </RadzenText>
            <RadzenText TextStyle="TextStyle.Body1" Class="my-1">
            Detalhes das categorias
            </RadzenText>
            <div class="col">
                <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add_circle_outline" Class="mt-2 mb-4" Text="Add Categoria" Style="width:200px" Click="Create" />
            </div>
            <div>
             <GridCategoria></GridCategoria>
            </div>
         }       
        else
        {
            if (IsLoading)
            {
                <div class="text-center">
                    <img src="/images/loading.gif">
                </div>
            }
            else
            {
                <p>Nenhum registro foi encontrado</p>
            }
        }
    </div>
 </div>

  <div class="row mt-1">
     
 </div>
    
@code {

    [Parameter]
    public EventCallback<bool>ConfirmationChanged { get; set; }

    private IEnumerable<CategoriaDTO> Categorias { get; set; } = new List<CategoriaDTO>();
    private bool IsLoading { get; set; }
    public int DeleteCategoriaId { get; set; } = 0;
    public string NomeCategoria { get; set; }
    public string textModal = "Tem certeza que deseja deletar a categoria: ";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CarregaCategorias();
        }
    }

    private async Task CarregaCategorias()
    {
        IsLoading = true;
        StateHasChanged();
        Categorias = await _categoriaRepository.GetAll();
        IsLoading = false;
        StateHasChanged();
    }
    public async Task ConfirmaDelete(bool isConfirmed)
    {
        IsLoading = true;
        if(isConfirmed && DeleteCategoriaId != 0)
        {
            //Delete
            await _categoriaRepository.Delete(DeleteCategoriaId);
            await CarregaCategorias();
            await _jsRuntime.InvokeVoidAsync("OcultarModalConfirmacaoDelete");
        }
        IsLoading = false;
    }
    void Create()
    {
        _navigationManager.NavigateTo("categoria/create");
    }
}
