@page "/categoria"
@inject ICategoriaRepository _categoriaRepository
@inject IJSRuntime _jsRuntime

<_DeleteConfirmation IsParentComponentProcessing="IsLoading" ConfirmationChanged="ConfirmaDelete" Text="@textModal" Nome="@NomeCategoria"></_DeleteConfirmation>

<div class="row mt-4">
    <div class="col-6">
        <h4 class="card-title text-primary">Lista de Categoria</h4>
    </div>
    <div class="col-4 offset-2">
        <a href="categoria/create" class="btn btn-primary form-control">Adicionar</a>
    </div>
        <div class="col-12 p-3">
            @if (Categorias.Any())
            {
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th class="col-3">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var categoria in Categorias)
                    {
                        <tr>
                            <td>
                                @categoria.Nome
                            </td>
                            <td>
                                <NavLink href="@($"categoria/edit/{categoria.Id}")" class="btn btn-warning"><span class="oi oi-pencil" aria-hidden="true"></span> Editar</NavLink>
                                <NavLink @onclick="()=>HandleDelete(categoria.Id, categoria.Nome)" class="btn btn-danger"><span class="ep:delete" aria-hidden="true"></span> Excluir</NavLink>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            if (IsLoading)
            {
                <div class="text-center">
                    <img src="/images/loading.gif">
                </div>
            }
            else
            {
                <p>Nenhum registro foi encontrado</p>
            }
        }
    </div>
 </div>
    
@code {

    [Parameter]
    public EventCallback<bool>ConfirmationChanged { get; set; }

    private IEnumerable<CategoriaDTO> Categorias { get; set; } = new List<CategoriaDTO>();
    private bool IsLoading { get; set; }
    public int DeleteCategoriaId { get; set; } = 0;
    public string NomeCategoria { get; set; }
    public string textModal = "Tem certeza que deseja deletar a categoria: ";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CarregaCategorias();
        }
    }

    private async Task CarregaCategorias()
    {
        IsLoading = true;
        StateHasChanged();
        Categorias = await _categoriaRepository.GetAll();
        IsLoading = false;
        StateHasChanged();
    }
    private void HandleDelete(int id, string nome)
    {
        DeleteCategoriaId = id;
        NomeCategoria = nome;
        //chama o método JS
        _jsRuntime.InvokeVoidAsync("MostrarModalConfirmacaoDelete");
    }
    public async Task ConfirmaDelete(bool isConfirmed)
    {
        IsLoading = true;
        if(isConfirmed && DeleteCategoriaId != 0)
        {
            //Delete
            await _categoriaRepository.Delete(DeleteCategoriaId);
            await CarregaCategorias();
            await _jsRuntime.InvokeVoidAsync("OcultarModalConfirmacaoDelete");
        }
        IsLoading = false;
    }
}
