@page "/produto/create"
@page "/produto/edit/{id:int}"

@inject ICategoriaRepository _categoriaRepository
@inject IProdutoRepository _produtoRepository
@inject NavigationManager _navigationManager
@inject IFileUpLoad _fileUpload
@inject IJSRuntime _jsRuntime

<style>
    form .row {
        margin-bottom: 16px;
    }
</style>

<div class="row my-2">
@*    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H1" Class="my-1">
        Produtos
    </RadzenText>*@
    @if (IsLoading)
    {
                <div class="d-flex justify-content-center">
                    <div class="text-center">
                        <img src="/images/loading.gif">
                    </div>
                </div>                 
    }
    else
    {
           <RadzenTemplateForm TItem="ProdutoDTO"  Data="@produto" Submit="@((ProdutoDTO args) => { OnSubmit(args); })">
            <DataAnnotationsValidator/>
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-6">
                        <RadzenFieldset Text="Informações do produto">
                            <div class="row">
                                <div class="col-md-2 align-items-center d-flex">
                                    <RadzenLabel Text="Nome" />
                                </div>
                                <div class="col-md-10">
                                        <RadzenTextBox style="width: 100%;" Name="Nome" @bind-Value=@produto.Nome/>
                                     <ValidationMessage For="() => produto.Nome"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-2 align-items-center d-flex">
                                    <RadzenLabel Text="Descrição" />
                                </div>
                                <div class="col-md-10">
                                        <RadzenTextBox style="width: 100%;" Name="Descricao" @bind-Value=@produto.Descricao />
                                    <ValidationMessage For="() => produto.Descricao"/>
                                </div>
                            </div>
                            <div class="row">
                                    <div class="col-md-2 align-items-center d-flex">
                                        <RadzenLabel Text="Cor" />
                                    </div>
                                    <div class="col-md-3">
                                        <RadzenTextBox style="width: 100%;" Name="Cor" @bind-Value=@produto.Cor/>
                                        <ValidationMessage For="() => produto.Cor"/>
                                    </div>
                                    <div class="col-md-2 align-items-center d-flex">
                                        <RadzenLabel Text="Categoria" />
                                    </div>
                                    <div class="col-md-5">
                                         <RadzenDropDown TValue="int" Data=@lstCategoria TextProperty="Nome" ValueProperty="Id" Change="@OnChange" Placeholder="--Categoria--" Style="width:100%" @bind-Value=@produto.CategoriaId />
                                         <ValidationMessage For="() => produto.CategoriaId" />
                                    </div>
                                    
                                </div>
                                <div class="row">
                                    <div class="col-md-2 align-items-center d-flex">
                                            <RadzenLabel Text="Observação" />
                                    </div>
                                    <div class="col-md-10">
                                            <RadzenTextArea style="width: 100%;" Name="Observacao" @bind-Value=@produto.Observacao/>
                                            <ValidationMessage For="() => produto.Cor"/>
                                    </div>
                                </div>
                            <div class="row">
                                <div class="col-md-2 align-items-center d-flex">
                                    <RadzenLabel Text="Imagem" />
                                </div>
                                 <div class="col-md-10">
                                 <InputFile OnChange="HandleImageUpload" class="form-control"></InputFile>                                       
                                </div>
                            </div>
                            <div class="row">
                                <div class="align-items-center d-flex col-md-2">
                                    <RadzenLabel Text="Inclusão" />
                                </div>
                                <div class="col-md-4">
                                    <RadzenDatePicker style="width: 100%;" Name="DtIncl" @bind-Value="produto.DataCriacao" Disabled="true" />
                                </div>
                                <div class="align-items-center d-flex col-md-2">
                                    <RadzenLabel Text="Alteração" />
                                </div>
                                <div class="col-md-4">
                                    <RadzenDatePicker style="width: 100%;" Name="DtAlter" @bind-Value="produto.DataAlteracao" Disabled="true" />
                                </div>
                            </div>
                            <div class="row">
                                 <div class="col-md-3 align-items-center d-flex">
                                     <RadzenLabel Text="Valor Compra" />
                                 </div>
                                <div class="col-md-3">
                                        <RadzenNumeric TValue="double" Format="c" @bind-Value="produto.ValorCompra" />
                                </div>
                                    <div class="col-md-3 align-items-center d-flex">
                                        <RadzenLabel Text="Preço Venda" />
                                     </div>
                                    <div class="col-md-3">
                                        <RadzenNumeric TValue="double" Format="c" @bind-Value="produto.PrecoVenda" />
                                    </div>
                            </div>
                        </RadzenFieldset>
                    </div>
                </div>
                    <div class="col-md-10 d-flex align-items-end justify-content-center" style="margin-top: 16px;">
                        <RadzenButton ButtonType="ButtonType.Submit" Icon=@iconeBotao Text=@textoBotao />
                        <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="cancel" style="display: inline-block; margin-left: 10px;" Text="Cancel" Click="@Cancel" />
                    </div>
            </div>
            </RadzenTemplateForm>
    }
</div>


@code {
    [Parameter]
    public int Id { get; set; }

    private ProdutoDTO produto { get; set; } = new()
    {
        ImageUrl = "/images/default.png",
        ValorCompra = 0.0,
        PrecoVenda = 0.0,
        DataCriacao = DateTime.Now
    };
    private IEnumerable<CategoriaDTO> Categorias { get; set; } = new List<CategoriaDTO>();
    private IEnumerable<ProdutoDTO> Produtos { get; set; } = new List<ProdutoDTO>();
    IEnumerable<CategoriaDTO> lstCategoria;
    private bool IsLoading { get; set; }

    RadzenUpload upload;
    int progress;
    bool showProgress;
    bool showComplete;
    string completionMessage;
    bool cancelUpload = false;

    //Variáveis responsáveis pela interação de componentes
    string iconeBotao = "save";
    string textoBotao = "Salvar";

    protected async override Task OnInitializedAsync()
    {
        await ObterProduto();

    }
    private async Task ObterProduto()
    {
        IsLoading = true;
        StateHasChanged();
        Categorias = await _categoriaRepository.GetAll();
        lstCategoria = Categorias.ToList();
        if(Id != 0){
            //update
            produto = await _produtoRepository.Get(Id);
            iconeBotao = "edit";
            textoBotao = "Editar";
        }
        IsLoading = false;
        StateHasChanged();
    }

    void CompleteUpload(UploadCompleteEventArgs args)
    {
        if (!args.Cancelled)
            completionMessage = "Upload Complete!";
        else
            completionMessage = "Upload Cancelled!";

        showProgress = false;
        showComplete = true;
    }
    void TrackProgress(UploadProgressArgs args)
    {
        showProgress = true;
        showComplete = false;
        progress = args.Progress;

        // cancel upload
        args.Cancel = cancelUpload;

        // reset cancel flag
        cancelUpload = false;
    }
    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        try
        {
            if (e.GetMultipleFiles().Count > 0)
            {
                foreach (var arquivo in e.GetMultipleFiles())
                {
                    System.IO.FileInfo arquivoInfo = new System.IO.FileInfo(arquivo.Name);
                    if (arquivoInfo.Extension.ToLower() == ".jpg" ||
                        arquivoInfo.Extension.ToLower() == ".png" ||
                        arquivoInfo.Extension.ToLower() == ".jpeg")
                    {
                        produto.ImageUrl = await _fileUpload.UploadFiles(arquivo);
                    }
                    else
                    {
                        await _jsRuntime.ToastrError("Permitido apenas arquivos com extensão .jpg/.jpeg/.png");
                    }
                }
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            await _jsRuntime.ToastrError(ex.Message);
            StateHasChanged();
        }
    }
    void Cancel()
    {
        _navigationManager.NavigateTo("/produto");
    }
    async void OnSubmit(ProdutoDTO produto)
    {
        if (produto.Id == 0)
        {
            await _produtoRepository.Create(produto);
        }        
        else
        {
            produto.DataAlteracao = DateTime.Now;
            await _produtoRepository.Update(produto);
        }
        _navigationManager.NavigateTo("produto");
    }
    void OnChange(object value)
    {
        produto.CategoriaId = Convert.ToInt32(value);
    }
}
