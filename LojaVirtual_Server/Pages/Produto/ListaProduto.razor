@page "/produto"
@inject IProdutoRepository _produtoRepository
@inject IJSRuntime _jsRuntime
@inject IFileUpLoad _fileUpload
@inject NavigationManager _navigationManager


 <div class="row mt-1">
     <div class="col-12 p-3">
        @if (Produtos.Any())
        {
        <RadzenText TextStyle="TextStyle.H3" TagName="TagName.H1" Class="my-1">
            Produtos
        </RadzenText>
        <RadzenText TextStyle="TextStyle.Body1" Class="my-1">
            Detalhes dos produtos
        </RadzenText>
            <div class="col">
                <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add_circle_outline" Class="mt-2 mb-4" Text="Add Produto" Style="width:180px" Click="Create" />
            </div>
         <div>
             <GridProdutos></GridProdutos>
            </div>
        }
        else
        {
            if (IsLoading)
            {
                <div class="text-center">
                    <img src="/images/loading.gif">
                </div>
            }
            else
            {
                <p>Nenhum registro foi encontrado</p>
            }
        }
    </div>
     
 </div>

@code {
    [Parameter]
    public EventCallback<bool> ConfirmationChanged { get; set; }

    private IEnumerable<ProdutoDTO> Produtos { get; set; } = new List<ProdutoDTO>();
    private bool IsLoading { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ListarProdutos();
        }
    }

    private async Task ListarProdutos()
    {
        IsLoading = true;
        StateHasChanged();
        Produtos = await _produtoRepository.GetAll();
        IsLoading = false;
        StateHasChanged();
    }
    
    void Create()
    {
        _navigationManager.NavigateTo("produto/create");
    }

}
