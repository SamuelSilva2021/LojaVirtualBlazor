@page "/datagrid"

@inject IProdutoRepository _produtoRepository

<div>
@if(produto == null){
    <p>Loading.....</p>
}else{
    <RadzenGrid AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" 
    AllowPaging="true" PageSize="4" AllowSorting="true" Data="@produto" TItem="ProdutoDTO" ColumnWidth="150px">
    <Columns>
            @*<RadzenDataGridColumn TItem="ProdutoDTO" Title="Imagem" Frozen="true" Sortable="false" Filterable="false" Width="80px" TextAlign="TextAlign.Center" >
                <Template Context="Data">
                        <RadzenImage Path="@produto.ImageUrl" class="rz-gravatar" />
                </Template>
        </RadzenDataGridColumn>*@
        <RadzenGridColumn TItem="ProdutoDTO" Property="Id" Title="Produto ID"></RadzenGridColumn>
        <RadzenGridColumn TItem="ProdutoDTO" Property="Nome" Title="Produto Nome"></RadzenGridColumn>
        <RadzenGridColumn TItem="ProdutoDTO" Property="Descricao" Title="Produto ID"></RadzenGridColumn>
        <RadzenGridColumn TItem="ProdutoDTO" Property="FavoritosShop" Title="Produto ID"></RadzenGridColumn>
    </Columns>
    </RadzenGrid>
}
</div>

@code {
    IEnumerable<ProdutoDTO> produto;
    private List<string> imagens = new List<string>();

    protected override async Task OnInitializedAsync()
    {
        produto = await Task.Run(() => _produtoRepository.GetAll());
    }
    



}