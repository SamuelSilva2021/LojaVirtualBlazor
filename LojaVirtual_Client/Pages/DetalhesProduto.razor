@page "/detalhes/{ProdutoId:int}"
@inject IProdutoService _produtoService

@if (IsProcessing)
{
    <div style="position:fixed;top:50%;left:50%;margin-top:-50px;margin-left:-100px;">
        <img src="images/ajax-loader.gif" />
    </div>
}
else
{
    <EditForm OnInvalidSubmit="AddToCart" Model="DetalhesVm" method="post">
        <DataAnnotationsValidator/>
         <div class = "card-wrapper">
          <div class = "card">
            <!-- card left -->
            <div class = "product-imgs">
              <div class = "img-display">
                <div class = "img-showcase">
                  <img src = "@Produto.ImageUrl" alt = "shoe image">
                  <img src = "Imagens/shoe_2.jpg" alt = "shoe image">
                  <img src = "Imagens/shoe_3.jpg" alt = "shoe image">
                  <img src = "Imagens/shoe_4.jpg" alt = "shoe image">
                </div>
              </div>
              <div class = "img-select">
                <div class = "img-item">
                  <a href = "#" data-id = "1">
                    <img src = "Imagens/shoe_1.jpg" alt = "shoe image">
                  </a>
                </div>
                <div class = "img-item">
                  <a href = "#" data-id = "2">
                    <img src = "Imagens/shoe_2.jpg" alt = "shoe image">
                  </a>
                </div>
                <div class = "img-item">
                  <a href = "#" data-id = "3">
                    <img src = "Imagens/shoe_3.jpg" alt = "shoe image">
                  </a>
                </div>
                <div class = "img-item">
                  <a href = "#" data-id = "4">
                    <img src = "Imagens/shoe_4.jpg" alt = "shoe image">
                  </a>
                </div>
              </div>
            </div>
            <!-- card right -->
            <div class = "product-content">
              <h2 class = "product-title">@Produto.Nome</h2>
@*              <a href = "#" class = "product-link">visit nike store</a>
*@              <div class = "product-rating">
                <i class = "fas fa-star"></i>
                <i class = "fas fa-star"></i>
                <i class = "fas fa-star"></i>
                <i class = "fas fa-star"></i>
                <i class = "fas fa-star-half-alt"></i>
                <span>4.7(21)</span>
              </div>

              <div class = "product-price">
@*                  criar lógica pra promoção
*@                  @if (Produto.PrecoVenda > 0)
                    {
                        <p class = "last-price">Preço: <span>$257.00</span></p>
                        <p class = "new-price">Promoção: <span>@Produto.PrecoVenda.ToString("C")</span></p>    
                    }                   
              </div>

              <div class = "product-detail">
                <h2>Detalhes do Produto: </h2>
                <p>@Produto.Descricao</p>
                <p class="dadosProd">Cor: <span>@Produto.Cor</span></p>
                <p class="dadosProd">Estoque: <span>100</span></p>
                <p class="dadosProd">Categoria: <span>@Produto.Categoria.Nome</span></p>              
              </div>

              <div class = "purchase-info">
                <input type = "number" min = "0" value = "1">
                <button type = "button" class = "btn">
                  Add Carrinho <i class = "fas fa-shopping-cart"></i>
                </button>
@*                <button type = "button" class = "btn">Compare</button>
*@              </div>

              <div class = "social-links">
                <p>Redes Sociais: </p>
                <a href = "#">
                  <i class = "fab fa-facebook-f"></i>
                </a>
                <a href = "#">
                  <i class = "fab fa-twitter"></i>
                </a>
                <a href = "#">
                  <i class = "fab fa-instagram"></i>
                </a>
                <a href = "#">
                  <i class = "fab fa-whatsapp"></i>
                </a>
                <a href = "#">
                  <i class = "fab fa-pinterest"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
            </EditForm>
}

    
@code{
    [Parameter]
    public int ProdutoId { get; set; }
    public ProdutoDTO Produto { get; set; } = new();
    public bool IsProcessing { get; set; } = false;
    public DetalhesVM DetalhesVm { get; set; }

    protected override async Task OnInitializedAsync()
    {
        IsProcessing = true;
        Produto = await _produtoService.Get(ProdutoId);
        IsProcessing = false;
    }
    public async void AddToCart()
    {
        
    }
}